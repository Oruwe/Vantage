{"id": "s01-pure-text", "question": "Say hi.", "note": "No tools, single text response.", "script": [{"content": [{"type": "text", "text": "Hi — Vantage here, ready to investigate."}], "stop_reason": "end_turn"}], "tool_outputs": {}, "expected_tools": [], "forbidden_tools": ["probe_live", "ask_dev"], "max_loops": 1, "must_mention": ["Vantage"]}
{"id": "s02-single-tool", "question": "Who's on the team?", "note": "list_developers → text.", "script": [{"content": [{"type": "tool_use", "id": "t1", "name": "list_developers", "input": {}}], "stop_reason": "tool_use"}, {"content": [{"type": "text", "text": "Alice and Bob are online; Carol is offline."}], "stop_reason": "end_turn"}], "tool_outputs": {"list_developers": {"developers": [{"name": "alice", "online": true}, {"name": "bob", "online": true}, {"name": "carol", "online": false}]}}, "expected_tools": ["list_developers"], "forbidden_tools": ["probe_live"], "max_loops": 2, "must_mention": ["Alice", "Carol"]}
{"id": "s03-two-tool-chain", "question": "What has Alice been working on this week?", "note": "get_timeline then search_artifacts for cross-team context.", "script": [{"content": [{"type": "tool_use", "id": "t1", "name": "get_timeline", "input": {"developer_id": "alice", "limit": 10}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t2", "name": "search_artifacts", "input": {"query": "auth refactor", "developer_id": "alice"}}], "stop_reason": "tool_use"}, {"content": [{"type": "text", "text": "Alice has been on the auth refactor: commit abc123 landed Monday, PR #42 opened Wednesday."}], "stop_reason": "end_turn"}], "tool_outputs": {"get_timeline": {"artifacts": [{"id": "c1", "type": "commit_report", "title": "abc123: auth refactor"}]}, "search_artifacts": {"hits": [{"id": "p42", "type": "pr_draft", "title": "PR #42: finalize auth"}]}}, "expected_tools": ["get_timeline", "search_artifacts"], "forbidden_tools": ["probe_live", "ask_dev"], "max_loops": 3, "must_mention": ["Alice", "abc123", "PR #42"]}
{"id": "s04-no-results-reformulate", "question": "Any bug resolutions this week?", "note": "First search returns empty; agent reformulates and tries again.", "script": [{"content": [{"type": "tool_use", "id": "t1", "name": "search_artifacts", "input": {"query": "bug resolution"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t2", "name": "search_artifacts", "input": {"query": "fix", "channel": "bug_resolution"}}], "stop_reason": "tool_use"}, {"content": [{"type": "text", "text": "Found one bug resolution: timeout fix in payment-service by Bob."}], "stop_reason": "end_turn"}], "tool_outputs": {"search_artifacts": [{"hits": []}, {"hits": [{"id": "r1", "title": "payment-service timeout fix", "developer": "bob"}]}]}, "expected_tools": ["search_artifacts"], "forbidden_tools": [], "max_loops": 3, "must_mention": ["Bob", "timeout"]}
{"id": "s05-tool-error-recovery", "question": "Show the brief.", "note": "get_brief errors; agent surfaces that gracefully rather than looping.", "script": [{"content": [{"type": "tool_use", "id": "t1", "name": "get_brief", "input": {"hours": 24}}], "stop_reason": "tool_use"}, {"content": [{"type": "text", "text": "I couldn't retrieve the brief — the tool reported an error. Suggest checking the replica logs."}], "stop_reason": "end_turn"}], "tool_outputs": {"get_brief": {"error": "upstream timeout"}}, "expected_tools": ["get_brief"], "forbidden_tools": [], "max_loops": 2, "must_mention": ["error"]}
{"id": "s06-dangerous-tool-blocked", "question": "Probe Alice to see what she's doing right now.", "note": "Non-streaming endpoint must synthesize a denial for probe_live; agent should pivot without looping.", "script": [{"content": [{"type": "tool_use", "id": "t1", "name": "probe_live", "input": {"developer_id": "alice"}}], "stop_reason": "tool_use"}, {"content": [{"type": "text", "text": "I can't run a live probe here — that needs the streaming endpoint. Try the dashboard."}], "stop_reason": "end_turn"}], "tool_outputs": {}, "expected_tools": ["probe_live"], "forbidden_tools": [], "max_loops": 2, "must_mention": ["streaming"]}
{"id": "s07-budget-exhaustion", "question": "Keep searching forever.", "note": "Model never stops emitting tool_use; agent must terminate at 8 loops with budget_exhausted=true.", "script": [{"content": [{"type": "tool_use", "id": "t1", "name": "search_artifacts", "input": {"query": "x"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t2", "name": "search_artifacts", "input": {"query": "y"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t3", "name": "search_artifacts", "input": {"query": "z"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t4", "name": "search_artifacts", "input": {"query": "a"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t5", "name": "search_artifacts", "input": {"query": "b"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t6", "name": "search_artifacts", "input": {"query": "c"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t7", "name": "search_artifacts", "input": {"query": "d"}}], "stop_reason": "tool_use"}, {"content": [{"type": "tool_use", "id": "t8", "name": "search_artifacts", "input": {"query": "e"}}], "stop_reason": "tool_use"}], "tool_outputs": {"search_artifacts": {"hits": []}}, "expected_tools": ["search_artifacts"], "forbidden_tools": [], "max_loops": 8, "must_mention": [], "expect_budget_ok": false}
